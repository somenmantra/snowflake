"UNION BY NAME" In Snowflake 
*/


create database demo_db;
create schema demo_schema;

CREATE OR REPLACE TABLE Employee (
    id INT,
    name VARCHAR(50),
    department VARCHAR(50),
    role VARCHAR(50)
);

CREATE OR REPLACE TABLE Contractor (
    id INT,
    name VARCHAR(50),
    department VARCHAR(50),
    role VARCHAR(50)
);

//ALTER TABLE Contractor DROP COLUMN role;

