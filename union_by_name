INSERT INTO Contractor (id, name, department, role) VALUES
(101, 'David', 'Engineering', 'Contract Developer'),
(102, 'Eve', 'HR', 'Recruiter'),
(103, 'Frank', 'Finance', 'Consultant');


ALTER TABLE Contractor DROP COLUMN role;

SELECT id, name FROM Employee
UNION BY NAME
SELECT name, id FROM Contractor;


SELECT * FROM Employee
UNION BY NAME
SELECT * FROM Contractor;


/*
1. Allows to perform union based on column names
regardless of their order.
2. Works even if the presence of extra columns.
*/

